<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The updater's two permissions. Nothing else in the app touches
      REQUEST_INSTALL_PACKAGES; INTERNET is shared with the MCP control port
      below, which needs it to open a socket at all.

      com.trickhook.update makes one HTTPS request to
      api.github.com for the latest release, one for that release's metadata
      asset, and one for the APK itself once the user has seen what it is and
      pressed Download. There is no schedule, no background work and no
      analytics — a check happens when someone asks for it, or on launch only
      after they have turned that on by hand. No binary you open, no name you
      type and no part of the project database ever leaves the device.

      REQUEST_INSTALL_PACKAGES is what lets the verified APK be handed to the
      system installer. Since API 26 the user must additionally grant "install
      unknown apps" to this app specifically; the updater detects that and sends
      them to the right settings screen rather than failing silently.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      The MCP control port (com.trickhook.mcp).

      INTERNET is listed above for the updater, and the server needs it too:
      Android gates the creation of ANY socket on the inet group, which that
      permission is what grants. It makes no outbound connections of its own.

      FOREGROUND_SERVICE and FOREGROUND_SERVICE_SPECIAL_USE are for McpService.
      The service exists so the listening socket is not frozen or killed in the
      background, and — the part that matters more — so that a phone which is
      listening on a network port says so in the status bar for as long as it
      is. specialUse rather than dataSync: this is not a sync, it holds a
      user-initiated local control port, and dataSync carries a six-hour daily
      budget on Android 15 that has nothing to do with this.

      POST_NOTIFICATIONS is asked for at the moment the user turns the server
      on, never at launch. Refusing it does not stop the server; it only hides
      the notification, which is why the app asks rather than assumes.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The Shizuku debugger backend (com.trickhook.shizuku).

      moe.shizuku.manager.permission.API_V23 is Shizuku's own permission: it is
      granted by the user inside Shizuku, not by Android, and without it every
      call on the Shizuku class throws. The provider AAR merges this line in by
      itself; it is written out here because a permission this app asks for
      should be readable in this file rather than only in a merged manifest.

      Nothing here is asked for at launch. The app never touches Shizuku until
      someone opens the Debugger tab and chooses the Shizuku backend, and it
      works exactly as before on a device that has never heard of it.
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!--
      Package visibility, required since API 30.

      The debugger tab has to tell "Shizuku is not installed" apart from
      "Shizuku is installed but not running", because those are different
      problems with different answers and a single "unavailable" helps nobody.
      Telling them apart means asking the PackageManager about one package by
      name, and targetSdk 30+ hides every package that is not declared here.

      This is also what makes the "Open Shizuku" button able to find a launch
      Intent. It grants no access to the package, only the ability to see that
      it exists.
    -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nocturne"
        android:usesCleartextTraffic="false">

        <!--
          configChanges: turning the phone sideways is the obvious response to
          truncated disassembly, and recreating the Activity for it threw away
          every panel's scroll position, search box and graph viewport. There
          are no orientation- or size-qualified resources in this project, so
          there is nothing for a recreation to re-resolve; Compose reacts to
          the new configuration on its own. Font scale and night mode are
          deliberately NOT listed — those are rare and a clean recreation is
          the right answer there.

          adjustResize so WindowInsets.ime is reported and imePadding() works
          below API 30.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The verified APK is handed to the system installer as a content:// URI
          from here. A file:// URI throws FileUriExposedException on API 24 and
          up, and the download lives in app-private storage, which the installer
          has no other way to read.

          exported="false" with grantUriPermissions="true" is the whole security
          model: nothing can pull a file out of this provider on its own, and the
          installer only reads the one URI that Intent.FLAG_GRANT_READ_URI_PERMISSION
          hands it, for as long as that intent lives. res/xml/update_file_paths.xml
          exposes exactly one directory, which holds exactly one file.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!--
          Shizuku's binder delivery point.

          This provider is not ours to design: Shizuku hands an app its binder
          by calling into this ContentProvider, and rikka.shizuku.ShizukuProvider
          throws from attachInfo unless exported is true and multiprocess is
          false — so both are fixed, not chosen.

          exported="true" with no permission would leave a call() surface open
          to every app on the device. android.permission.INTERACT_ACROSS_USERS_FULL
          is a signature|privileged permission that no third-party app can hold,
          so in practice only the system and Shizuku itself can reach it. This is
          the configuration Shizuku's own demo ships and the one its
          documentation specifies.

          onCreate here also initialises Sui, so a rooted device with the Sui
          module works with no separate code path.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
          The MCP control port. Off until a person switches it on in the app:
          there is no BOOT_COMPLETED receiver, nothing starts it on launch, and
          McpService returns START_NOT_STICKY so the system will not restart it
          after a kill either.

          exported="false" so no other app on the device can start or stop it
          with an Intent. The socket it opens is protected separately, by a
          256-bit bearer token required on every request.

          stopWithTask="true" because swiping Nocturne away should take the
          listener with it. A port left open by an app the user thinks they
          closed is exactly the situation this feature must never create.

          specialUse is the honest type: this is a user-initiated local control
          port, not a sync, a media session or a location fix. The subtype
          property below is what Android asks an app to declare when it uses it.
        -->
        <service
            android:name=".mcp.McpService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local MCP control port, started by the user, stopped when idle" />
        </service>
    </application>

</manifest>
