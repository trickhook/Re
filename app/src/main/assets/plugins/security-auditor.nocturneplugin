{
  "id": "security-auditor",
  "name": "Security Auditor",
  "version": "1.0",
  "author": "SakoRE",
  "description": "Flags dangerous imports (strcpy/system/dlopen), large functions and suspicious strings.",
  "script": "## SakoRE Security Auditor\nlog(\"=== Security Audit ===\")\nn = count_functions()\nni = count_imports()\nlog(\"functions:\", n, \"\u00b7 imports:\", ni)\n\nrisky = 0\nfor i in 0..ni-1 {\n    imp = import_at(i)\n    k = classify(imp.name)\n    if k != nil {\n        if k == \"dangerous\" {\n            log(\"[!] UNSAFE import:\", imp.name, \"- no bounds check\")\n            risky = risky + 1\n        }\n        if k == \"exec\" {\n            log(\"[!] PROCESS EXEC:\", imp.name)\n            risky = risky + 1\n        }\n        if k == \"dynload\" {\n            log(\"[!] DYNAMIC LOADING:\", imp.name, \"(possible hooking/packing)\")\n            risky = risky + 1\n        }\n        if k == \"memory-prot\" {\n            log(\"[!] MEM PROTECT:\", imp.name, \"(self-modifying code?)\")\n        }\n    }\n}\n\nbig = 0\nfor i in 0..n-1 {\n    f = func_at(i)\n    if f.size > 2048 {\n        comment(f.addr, \"LARGE function \u2014 audit manually\")\n        log(\"[i] large function:\", f.name, \"=\", f.size, \"bytes\")\n        big = big + 1\n    }\n}\n\nns = count_strings()\nurls = 0\nfor i in 0..ns-1 {\n    s = string_at(i)\n    if strlen(s.value) > 7 {\n        if classify(s.value) == nil {\n            ## crude URL check via string prefix\n            if charat(s.value, 0) == 104 {  ## 'h' of http\n                log(\"[?] possible URL:\", s.value)\n                urls = urls + 1\n            }\n        }\n    }\n}\n\nlog(\"=== done: \", risky, \" risky imports \u00b7\", big, \" large funcs \u00b7\", urls, \" urls ===\")\n"
}