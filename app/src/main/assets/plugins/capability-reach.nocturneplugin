{
  "id": "capability-reach",
  "name": "Capability Reachability",
  "version": "1.0",
  "author": "Nocturne",
  "description": "For each exported entry point, walks the call graph and reports which native capabilities are reachable from it and by what path.",
  "script": "## -- helpers (NocturneScript has no arrays or substring ops) --------------\nfun startsWith(s, p) {\n    lp = strlen(p)\n    if lp > strlen(s) { return false }\n    i = 0\n    while i < lp { if charat(s, i) != charat(p, i) { return false }  i = i + 1 }\n    return true\n}\n\nfun pad(s, w) {\n    out = s\n    i = strlen(s)\n    while i < w { out = out + \" \"  i = i + 1 }\n    return out\n}\n\n## One concrete path from `root` down to `target`, rebuilt by always stepping\n## to a callee that is one hop closer. reaches() gives the distance and\n## callee_at() gives the candidates; between them a shortest path falls out\n## without a queue, which the language could not hold anyway.\nfun pathTo(root, target, maxHops) {\n    cur = root\n    line = \"\"\n    hops = 0\n    while hops < maxHops {\n        d = reaches(cur, target)\n        if d < 1 { break }\n        nc = count_callees(cur)\n        k = 0\n        step = 0\n        stepName = \"\"\n        while k < nc {\n            cc = callee_at(cur, k)\n            if reaches(cc.addr, target) == d - 1 {\n                step = cc.addr\n                stepName = cc.name\n                break\n            }\n            k = k + 1\n        }\n        if step == 0 { break }\n        if stepName == \"\" { stepName = hex(step) }\n        line = line + \" -> \" + stepName\n        if step == target { break }\n        cur = step\n        hops = hops + 1\n    }\n    return line\n}\n\n## Which capability does this import name belong to, and is it worth a line?\n## classify() covers the broad classes the engine already knows; this adds the\n## ones an Android reverser asks about by name.\nfun capOf(nm) {\n    if nm == \"ptrace\" { return \"anti-debug\" }\n    if nm == \"kill\" or nm == \"tgkill\" or nm == \"raise\" { return \"anti-debug\" }\n    if nm == \"prctl\" { return \"anti-debug\" }\n    if nm == \"fork\" or nm == \"vfork\" or nm == \"clone\" { return \"process\" }\n    if nm == \"execve\" or nm == \"execl\" or nm == \"execlp\" or nm == \"execvp\" { return \"process\" }\n    if nm == \"system\" or nm == \"popen\" { return \"process\" }\n    if nm == \"dlopen\" or nm == \"android_dlopen_ext\" { return \"runtime-load\" }\n    if nm == \"dlsym\" or nm == \"dladdr\" { return \"runtime-load\" }\n    if nm == \"mprotect\" or nm == \"mmap\" or nm == \"munmap\" { return \"memory-map\" }\n    if nm == \"socket\" or nm == \"connect\" or nm == \"send\" or nm == \"sendto\" { return \"network\" }\n    if nm == \"recv\" or nm == \"recvfrom\" or nm == \"getaddrinfo\" { return \"network\" }\n    if nm == \"fopen\" or nm == \"open\" or nm == \"openat\" or nm == \"access\" { return \"filesystem\" }\n    if nm == \"stat\" or nm == \"lstat\" or nm == \"readlink\" or nm == \"opendir\" { return \"filesystem\" }\n    if nm == \"__system_property_get\" or nm == \"__system_property_find\" { return \"device-probe\" }\n    if nm == \"uname\" or nm == \"getuid\" or nm == \"geteuid\" or nm == \"getpwuid\" { return \"device-probe\" }\n    if nm == \"syscall\" { return \"raw-syscall\" }\n    return nil\n}\n\nlog(\"=== Capability Reachability ===\")\nlog(\"Everything Java can call into this library is an entry point. For each\")\nlog(\"one, this walks the call graph and says which native capabilities are\")\nlog(\"reachable from it, and by what path.\")\nlog(\"\")\n\nMAXHOPS = 24\n\nn = count_functions()\nni = count_imports()\n\n## The entry points are the dynamic exports: on a JNI library that is\n## JNI_OnLoad and the Java_* methods, and they are the only addresses anything\n## outside this file can call.\nne = count_exports()\nroots = 0\nfor i in 0..ne-1 {\n    e = export_at(i)\n    if e.kind == \"FUNC\" or e.kind == \"\" { roots = roots + 1 }\n}\nif roots == 0 {\n    log(\"This binary exports no functions, so there is no boundary to measure\")\n    log(\"from. Nothing to do.\")\n    return\n}\nlog(\"exported functions:\", roots, \"of\", ne, \"exports · imports:\", ni)\nlog(\"\")\n\ntotalPairs = 0\nfor i in 0..ne-1 {\n    e = export_at(i)\n    if e.kind != \"FUNC\" and e.kind != \"\" { continue }\n    f = func_containing(e.addr)\n    if f == nil { f = e }\n\n    kind = \"exported function\"\n    if f.name == \"JNI_OnLoad\" { kind = \"JNI_OnLoad - runs when System.loadLibrary returns\" }\n    if startsWith(f.name, \"Java_\") { kind = \"JNI method - callable directly from Java\" }\n    if e.size > 0 { kind = kind + \" - \" + str(e.size) + \" bytes\" }\n\n    log(\"[entry]\", e.name, \"@\", hex(e.addr))\n    log(\"        \" + kind)\n\n    found = 0\n    for j in 0..ni-1 {\n        imp = import_at(j)\n        ## imp.addr is the PLT stub on ELF and the IAT slot on PE -- the address\n    ## a call to this import actually reaches, whichever format this is.\n    if imp.addr == 0 { continue }\n        cap = capOf(imp.name)\n        if cap == nil { continue }\n        d = reaches(e.addr, imp.addr)\n        if d < 1 { continue }\n        found = found + 1\n        totalPairs = totalPairs + 1\n        log(\"    \" + pad(cap, 14) + pad(imp.name, 22) + str(d) + \" hops\")\n        p = pathTo(e.addr, imp.addr, MAXHOPS)\n        if p != \"\" { log(\"        \" + e.name + p) }\n        comment(e.addr, \"reaches \" + imp.name + \" (\" + cap + \") in \" + str(d) + \" hops\")\n    }\n    if found == 0 {\n        log(\"    reaches none of the capabilities this plugin looks for\")\n    } else {\n        bookmark(e.addr, \"entry: \" + e.name + \" (\" + str(found) + \" capabilities)\")\n    }\n    log(\"\")\n}\n\nlog(\"--- summary ---\")\nlog(totalPairs, \"entry-point/capability pairs are reachable.\")\nif totalPairs > 0 {\n    log(\"Each line above is a chain of direct calls the analysis actually found.\")\n    log(\"Indirect calls through registers are not in it - check the Obfuscation\")\n    log(\"Profile for how much of this binary dispatches that way, because what\")\n    log(\"that number hides is exactly what is missing here.\")\n}\nlog(\"=== done ===\")\n"
}
