{
  "id": "attack-surface",
  "name": "Attack Surface",
  "version": "1.0",
  "author": "Nocturne",
  "description": "Groups imports into network, file, exec and memory capability classes and comments the callers of each.",
  "script": "## -- helpers (NocturneScript has no arrays or substring ops) --------------\nfun contains(s, p) {\n    ls = strlen(s)\n    lp = strlen(p)\n    if lp == 0 { return true }\n    if lp > ls { return false }\n    i = 0\n    while i <= ls - lp {\n        ok = true\n        j = 0\n        while j < lp {\n            if charat(s, i + j) != charat(p, j) {\n                ok = false\n                break\n            }\n            j = j + 1\n        }\n        if ok { return true }\n        i = i + 1\n    }\n    return false\n}\n\nfun startsWith(s, p) {\n    lp = strlen(p)\n    if lp > strlen(s) { return false }\n    i = 0\n    while i < lp {\n        if charat(s, i) != charat(p, i) { return false }\n        i = i + 1\n    }\n    return true\n}\n\nlog(\"=== Attack Surface ===\")\nni = count_imports()\n\nnet = 0\nfio = 0\nexe = 0\ndyn = 0\nmem = 0\n\nfor i in 0..ni-1 {\n    imp = import_at(i)\n    k = classify(imp.name)\n    if k != nil {\n        mark = nil\n        if k == \"network\" {\n            net = net + 1\n            mark = \"NETWORK\"\n        }\n        if k == \"file-io\" {\n            fio = fio + 1\n            mark = \"FILE I/O\"\n        }\n        if k == \"exec\" {\n            exe = exe + 1\n            mark = \"PROCESS EXEC\"\n        }\n        if k == \"dynload\" {\n            dyn = dyn + 1\n            mark = \"DYNAMIC LOAD\"\n        }\n        if k == \"memory-prot\" {\n            mem = mem + 1\n            mark = \"MEM PROTECT\"\n        }\n        if mark != nil {\n            nx = count_xrefs_to(imp.addr)\n            j = 0\n            while j < nx {\n                x = xref_to_at(imp.addr, j)\n                comment(x.from, mark + \" via \" + imp.name)\n                j = j + 1\n            }\n            log(\"[\" + mark + \"]\", imp.name, \"-\", nx, \"call sites\")\n        }\n    }\n}\n\nlog(\"--- summary ---\")\nlog(\"network:\", net, \"file-io:\", fio, \"exec:\", exe, \"dynload:\", dyn, \"mem-protect:\", mem)\nif exe > 0 and dyn > 0 {\n    log(\"[!] both process execution and dynamic loading are present - typical of a loader or packer\")\n}\nlog(\"=== done ===\")\n"
}
