{
  "id": "obfuscation-profile",
  "name": "Obfuscation Profile",
  "version": "1.0",
  "author": "Nocturne",
  "description": "Measures the instruction mix against ordinary compiler output and names the functions whose control flow has been flattened.",
  "script": "## -- helpers (NocturneScript has no arrays or substring ops) --------------\nfun pct(a, b) {\n    if b == 0 { return \"0\" }\n    w = a * 1000 / b\n    w = w - (w % 1)\n    return str(w / 10)\n}\n\nfun pad(s, w) {\n    out = s\n    i = strlen(s)\n    while i < w { out = out + \" \"  i = i + 1 }\n    return out\n}\n\nlog(\"=== Obfuscation Profile ===\")\nlog(\"Measures how this binary's instruction mix differs from ordinary compiler\")\nlog(\"output, and names the functions whose control flow has been flattened.\")\nlog(\"\")\n\n## Reference figures, measured on a 17 MB stripped AArch64 build of LLVM --\n## ordinary -O2 output from the same compiler family:\n##     immediates built in registers  2.7%\n##     pc-relative data references    3.2%\n##     compares                       6.9%\n##     conditional branches          10.7%\n##     direct calls                   5.2%\nREF_MOVIMM = 3\nREF_PCREL = 3\n\nMINSIZE = 60          ## instructions; smaller functions carry no signal\nMAXBYTES = 20000      ## a 20 KB function is a separate problem\n\nn = count_functions()\ntotN = 0\ntotMov = 0\ntotPcrel = 0\ntotCmp = 0\ntotCbr = 0\ntotCall = 0\ntotInd = 0\ncovered = 0\nskipped = 0\n\nflat = 0\nflatInsns = 0\nshown = 0\n\nlog(\"--- flattened functions ---\")\nlog(\"  \" + pad(\"address\", 12) + pad(\"insns\", 8) + pad(\"states\", 8) +\n    pad(\"cmp%\", 7) + pad(\"cbr%\", 7) + \"function\")\n\nfor i in 0..n-1 {\n    f = func_at(i)\n    if f.size == 0 or f.size > MAXBYTES { skipped = skipped + 1  continue }\n    s = insn_stats(f.addr)\n    if s == nil { continue }\n    if s.n < MINSIZE { continue }\n\n    covered = covered + 1\n    totN = totN + s.n\n    totMov = totMov + s.movimm\n    totPcrel = totPcrel + s.pcrel\n    totCmp = totCmp + s.cmp\n    totCbr = totCbr + s.cbranch\n    totCall = totCall + s.call\n    totInd = totInd + s.indirect\n\n    ## Control-flow flattening: the body is cut into blocks, each given a\n    ## random 32-bit state number, and a dispatcher decides which runs next.\n    ## AArch64 cannot hold a 32-bit constant in a compare operand, so every\n    ## state number has to be assembled with movz+movk first -- which is why a\n    ## flattened function materialises dozens of unrelated constants and then\n    ## spends a tenth of itself comparing and branching on them.\n    dispatcher = s.cmp * 100 >= s.n * 8 and s.cbranch * 100 >= s.n * 8\n    manyStates = s.distinct_imm >= 24\n    if dispatcher and manyStates {\n        flat = flat + 1\n        flatInsns = flatInsns + s.n\n        comment(f.addr, \"FLATTENED - dispatcher over \" + str(s.distinct_imm) +\n                        \" state constants; the listing order is not the run order\")\n        bookmark(f.addr, \"flattened: \" + f.name)\n        if shown < 15 {\n            log(\"  \" + pad(hex(f.addr), 12) + pad(str(s.n), 8) +\n                pad(str(s.distinct_imm), 8) + pad(pct(s.cmp, s.n), 7) +\n                pad(pct(s.cbranch, s.n), 7) + f.name)\n            shown = shown + 1\n        }\n    }\n}\nif flat > shown { log(\"  ... and\", flat - shown, \"more\") }\nif flat == 0 { log(\"  none\") }\n\nlog(\"\")\nlog(\"--- instruction mix ---\")\nlog(\"covered\", covered, \"functions ·\", totN, \"instructions ·\",\n    skipped, \"skipped as too large or empty\")\nlog(\"  \" + pad(\"category\", 26) + pad(\"this binary\", 14) + \"ordinary AArch64\")\nlog(\"  \" + pad(\"immediates in registers\", 26) + pad(pct(totMov, totN) + \"%\", 14) + \"2.7%\")\nlog(\"  \" + pad(\"pc-relative data refs\", 26) + pad(pct(totPcrel, totN) + \"%\", 14) + \"3.2%\")\nlog(\"  \" + pad(\"compares\", 26) + pad(pct(totCmp, totN) + \"%\", 14) + \"6.9%\")\nlog(\"  \" + pad(\"conditional branches\", 26) + pad(pct(totCbr, totN) + \"%\", 14) + \"10.7%\")\nlog(\"  \" + pad(\"direct calls\", 26) + pad(pct(totCall, totN) + \"%\", 14) + \"5.2%\")\nlog(\"  \" + pad(\"indirect branches\", 26) + pad(pct(totInd, totN) + \"%\", 14) + \"0.6%\")\n\nlog(\"\")\nlog(\"--- verdict ---\")\nverdict = 0\n\nif totN > 0 and totMov * 100 > totN * (REF_MOVIMM * 3) {\n    log(\"[!!] \" + pct(totMov, totN) + \"% of instructions build a constant in a register,\")\n    log(\"     against about 3% for ordinary code.\")\n    verdict = verdict + 1\n}\nif totN > 0 and totPcrel * 100 < totN * REF_PCREL and totMov * 100 > totN * 10 {\n    log(\"[!!] and only \" + pct(totPcrel, totN) + \"% reference data pc-relatively.\")\n    log(\"     Constants are not being LOADED from .rodata, they are being BUILT.\")\n    log(\"     That is what a string and constant obfuscator does, and it is why\")\n    log(\"     the strings tab is nearly empty on a binary this size.\")\n    verdict = verdict + 1\n}\nif covered > 0 and flat * 4 >= covered {\n    log(\"[!!] \" + pct(flat, covered) + \"% of the functions examined are flattened (\" +\n        str(flat) + \" of \" + str(covered) + \"),\")\n    log(\"     covering \" + pct(flatInsns, totN) + \"% of the instructions.\")\n    log(\"     In those functions the order of the listing is not the order of\")\n    log(\"     execution; read them in the decompiler or under the emulator.\")\n    verdict = verdict + 1\n}\nif totN > 0 and totInd * 100 > totN * 2 {\n    log(\"[!] \" + pct(totInd, totN) + \"% indirect branches - dispatch through registers,\")\n    log(\"    so the call graph is incomplete by construction.\")\n    verdict = verdict + 1\n}\nif verdict == 0 {\n    log(\"Instruction mix is within range for ordinary compiler output, and no\")\n    log(\"function matched the flattening signature.\")\n}\nlog(\"=== done ===\")\n"
}
