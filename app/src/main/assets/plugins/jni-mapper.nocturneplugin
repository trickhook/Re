{
  "id": "jni-mapper",
  "name": "JNI Mapper",
  "version": "1.0",
  "author": "Nocturne",
  "description": "Marks every JNI entry point and the registration paths that bind natives at runtime.",
  "script": "## -- helpers (NocturneScript has no arrays or substring ops) --------------\nfun contains(s, p) {\n    ls = strlen(s)\n    lp = strlen(p)\n    if lp == 0 { return true }\n    if lp > ls { return false }\n    i = 0\n    while i <= ls - lp {\n        ok = true\n        j = 0\n        while j < lp {\n            if charat(s, i + j) != charat(p, j) {\n                ok = false\n                break\n            }\n            j = j + 1\n        }\n        if ok { return true }\n        i = i + 1\n    }\n    return false\n}\n\nfun startsWith(s, p) {\n    lp = strlen(p)\n    if lp > strlen(s) { return false }\n    i = 0\n    while i < lp {\n        if charat(s, i) != charat(p, i) { return false }\n        i = i + 1\n    }\n    return true\n}\n\nlog(\"=== JNI Mapper ===\")\nn = count_functions()\nentries = 0\n\nfor i in 0..n-1 {\n    f = func_at(i)\n    if startsWith(f.name, \"Java_\") {\n        log(\"[jni]\", f.name, \"@\", hex(f.addr))\n        comment(f.addr, \"JNI entry point - called from Java\")\n        bookmark(f.addr, \"JNI: \" + f.name)\n        entries = entries + 1\n    }\n    if f.name == \"JNI_OnLoad\" {\n        log(\"[jni] JNI_OnLoad @\", hex(f.addr), \"- registration happens here\")\n        comment(f.addr, \"JNI_OnLoad - RegisterNatives is usually called from here\")\n        bookmark(f.addr, \"JNI_OnLoad\")\n        entries = entries + 1\n    }\n}\n\nni = count_imports()\nfor i in 0..ni-1 {\n    imp = import_at(i)\n    if contains(imp.name, \"RegisterNatives\") {\n        log(\"[jni] dynamic registration via\", imp.name)\n        nx = count_xrefs_to(imp.addr)\n        j = 0\n        while j < nx {\n            x = xref_to_at(imp.addr, j)\n            comment(x.from, \"Registers native methods dynamically - names are not in the symbol table\")\n            j = j + 1\n        }\n    }\n}\n\nlog(\"=== done:\", entries, \"JNI entry points ===\")\n"
}
