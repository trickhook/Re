{
  "id": "anti-debug-scanner",
  "name": "Anti-Debug Scanner",
  "version": "1.0",
  "author": "Nocturne",
  "description": "Looks for ptrace self-attach, TracerPid reads and debuggable-property checks, and comments the callers.",
  "script": "## -- helpers (NocturneScript has no arrays or substring ops) --------------\nfun contains(s, p) {\n    ls = strlen(s)\n    lp = strlen(p)\n    if lp == 0 { return true }\n    if lp > ls { return false }\n    i = 0\n    while i <= ls - lp {\n        ok = true\n        j = 0\n        while j < lp {\n            if charat(s, i + j) != charat(p, j) {\n                ok = false\n                break\n            }\n            j = j + 1\n        }\n        if ok { return true }\n        i = i + 1\n    }\n    return false\n}\n\nfun startsWith(s, p) {\n    lp = strlen(p)\n    if lp > strlen(s) { return false }\n    i = 0\n    while i < lp {\n        if charat(s, i) != charat(p, i) { return false }\n        i = i + 1\n    }\n    return true\n}\n\nlog(\"=== Anti-Debug Scanner ===\")\nni = count_imports()\nfound = 0\n\nfor i in 0..ni-1 {\n    imp = import_at(i)\n    susp = false\n    why = \"\"\n    if contains(imp.name, \"ptrace\") {\n        susp = true\n        why = \"ptrace - self-attach blocks a debugger\"\n    }\n    if contains(imp.name, \"getppid\") {\n        susp = true\n        why = \"getppid - parent-process check\"\n    }\n    if contains(imp.name, \"kill\") {\n        susp = true\n        why = \"kill - may signal a watchdog\"\n    }\n    if contains(imp.name, \"sysconf\") {\n        susp = true\n        why = \"sysconf - timing baseline\"\n    }\n    if susp {\n        log(\"[anti-debug]\", imp.name, \"-\", why)\n        found = found + 1\n        nx = count_xrefs_to(imp.addr)\n        j = 0\n        while j < nx {\n            x = xref_to_at(imp.addr, j)\n            comment(x.from, \"ANTI-DEBUG: calls \" + imp.name)\n            j = j + 1\n        }\n    }\n}\n\nns = count_strings()\nfor i in 0..ns-1 {\n    s = string_at(i)\n    if contains(s.value, \"TracerPid\") {\n        log(\"[anti-debug] string:\", s.value, \"@\", hex(s.addr))\n        bookmark(s.addr, \"TracerPid check\")\n        found = found + 1\n    }\n    if contains(s.value, \"ro.debuggable\") or contains(s.value, \"/proc/self/status\") {\n        log(\"[anti-debug] string:\", s.value, \"@\", hex(s.addr))\n        bookmark(s.addr, \"debug-detection string\")\n        found = found + 1\n    }\n}\n\nif found == 0 {\n    log(\"no anti-debug evidence found\")\n}\nlog(\"=== done:\", found, \"indicators ===\")\n"
}
