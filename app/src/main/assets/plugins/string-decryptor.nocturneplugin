{
  "id": "string-decryptor",
  "name": "String Decryptor",
  "version": "1.0",
  "author": "Nocturne",
  "description": "Emulates every function with an output buffer and reports the plaintext it wrote, proving each string is not in the file, then comments the call sites.",
  "script": "## -- helpers (NocturneScript has no arrays or substring ops) --------------\nfun contains(s, p) {\n    ls = strlen(s)\n    lp = strlen(p)\n    if lp == 0 { return true }\n    if lp > ls { return false }\n    i = 0\n    while i <= ls - lp {\n        ok = true\n        j = 0\n        while j < lp {\n            if charat(s, i + j) != charat(p, j) {\n                ok = false\n                break\n            }\n            j = j + 1\n        }\n        if ok { return true }\n        i = i + 1\n    }\n    return false\n}\n\n## A probe buffer that a byte loop has walked reads as text: \"bcdefghib\",\n## \"234567892\". What gives it away is that almost every step is +1 (or -1, or\n## 0) -- and that it is short. A real materialised constant like a base-36\n## alphabet is also a ramp, but it is 36 characters long, so length is what\n## separates the finding from the artefact.\nfun isFiller(s) {\n    n = strlen(s)\n    if n < 2 { return true }\n    steps = 0\n    i = 1\n    while i < n {\n        a = charat(s, i - 1)\n        b = charat(s, i)\n        if b == a + 1 or b == a - 1 or b == a { steps = steps + 1 }\n        i = i + 1\n    }\n    ## 80% of the steps trivial, and too short to be a real alphabet\n    if steps * 10 >= (n - 1) * 8 and n < 20 { return true }\n    return false\n}\n\n## Plaintext is mostly letters and digits. A run of punctuation is a pointer\n## table read as text.\nfun wordy(s) {\n    n = strlen(s)\n    good = 0\n    i = 0\n    while i < n {\n        c = charat(s, i)\n        if c >= 48 and c <= 57 { good = good + 1 }\n        if c >= 65 and c <= 90 { good = good + 1 }\n        if c >= 97 and c <= 122 { good = good + 1 }\n        i = i + 1\n    }\n    return good * 2 >= n\n}\n\nlog(\"=== String Decryptor ===\")\nlog(\"Runs every function under the p-code emulator with an output buffer and\")\nlog(\"reports what it wrote. A string that is NOT in the file is one this\")\nlog(\"binary only has at runtime.\")\n\nMINLEN = 8\nn = count_functions()\ntried = 0\nskipped = 0\nrecovered = 0\ncopied = 0\nstoppedEarly = false\n\nfor i in 0..n-1 {\n    f = func_at(i)\n\n    ## Emulating a 20 KB function spends the whole per-call budget reaching\n    ## its first loop. Decrypt routines are small.\n    if f.size == 0 or f.size > 8192 {\n        skipped = skipped + 1\n        continue\n    }\n\n    ## probe shape: decrypt(out, in, len) — the sandbox allocates out and in,\n    ## which is the whole reason a plugin can call this at all.\n    r = emulate(f.addr, \"buf:256;buf:256;64\")\n    if r.stop == \"exhausted\" {\n        log(\"\")\n        log(\"[!] out of emulation budget after\", tried, \"functions -\", r.detail)\n        log(\"[!] the scan below is partial; nothing hung.\")\n        stoppedEarly = true\n        break\n    }\n    if r.stop == \"setup\" {\n        log(\"[!] the emulator is not available here:\", r.detail)\n        return\n    }\n    tried = tried + 1\n\n    nw = count_emu_writes()\n    j = 0\n    while j < nw {\n        m = emu_write_at(j)\n        if m.bestlen >= MINLEN and not isFiller(m.best) and wordy(m.best) {\n            where = find_bytes(m.best)\n            if where == 0 {\n                ## Not anywhere in the file. The code built it.\n                log(\"\")\n                log(\"[RECOVERED]\", m.best)\n                log(\"            from\", f.name, \"@\", hex(f.addr), \"-\", r.stop,\n                    \"-\", r.instructions, \"instructions, wrote to\", m.label)\n                if r.approximate {\n                    log(\"            (approximate: something was modelled as zero)\")\n                }\n\n                ## What it reached for on the way. A routine that called\n                ## memcpy and strlen is a string builder; one that called\n                ## fopen would be something else entirely, and that is worth\n                ## seeing next to the plaintext rather than three screens away.\n                nc = count_emu_calls()\n                if nc > 0 {\n                    names = \"\"\n                    seen = 0\n                    k = 0\n                    while k < nc and seen < 6 {\n                        cc = emu_call_at(k)\n                        if not contains(names, cc.name) {\n                            names = names + cc.name + \" \"\n                            seen = seen + 1\n                        }\n                        k = k + 1\n                    }\n                    log(\"            called out to:\", names, \"(\" + str(nc) + \" times)\")\n                }\n                comment(f.addr, \"DECRYPTS: \\\"\" + m.best + \"\\\" (recovered by emulation)\")\n                bookmark(f.addr, \"plaintext: \" + m.best)\n                recovered = recovered + 1\n\n                ## Everywhere this routine is called is now a site where that\n                ## string appears, which is the fact a reader wants in the\n                ## listing rather than in a log.\n                nx = count_xrefs_to(f.addr)\n                k = 0\n                sites = 0\n                while k < nx {\n                    x = xref_to_at(f.addr, k)\n                    comment(x.from, \"-> \\\"\" + m.best + \"\\\"\")\n                    g = func_containing(x.from)\n                    if g != nil and sites < 6 {\n                        log(\"            called from\", g.name, \"@\", hex(x.from))\n                        sites = sites + 1\n                    }\n                    k = k + 1\n                }\n                if nx == 0 { log(\"            no call sites found\") }\n            } else {\n                ## In the file already: the routine copied it, it did not\n                ## decrypt it. Still worth one line, never a bookmark.\n                copied = copied + 1\n                if copied <= 8 {\n                    log(\"[copied ]\", m.best, \"- already at\", hex(where))\n                }\n            }\n            break\n        }\n        j = j + 1\n    }\n}\n\nlog(\"\")\nlog(\"--- summary ---\")\nlog(\"functions emulated:\", tried, \"· skipped as too large:\", skipped)\nlog(\"strings recovered (not in the file):\", recovered)\nlog(\"strings the code merely copied:\", copied)\nif stoppedEarly {\n    log(\"stopped on the plugin emulation budget - re-run to continue, or raise\")\n    log(\"the size filter to cover fewer functions.\")\n}\nlog(\"=== done ===\")\n"
}
