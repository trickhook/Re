{
  "id": "string-triage",
  "name": "String Triage",
  "version": "1.0",
  "author": "Nocturne",
  "description": "Sorts strings into URLs, filesystem paths and format strings, and bookmarks the ones worth reading.",
  "script": "## -- helpers (NocturneScript has no arrays or substring ops) --------------\nfun contains(s, p) {\n    ls = strlen(s)\n    lp = strlen(p)\n    if lp == 0 { return true }\n    if lp > ls { return false }\n    i = 0\n    while i <= ls - lp {\n        ok = true\n        j = 0\n        while j < lp {\n            if charat(s, i + j) != charat(p, j) {\n                ok = false\n                break\n            }\n            j = j + 1\n        }\n        if ok { return true }\n        i = i + 1\n    }\n    return false\n}\n\nfun startsWith(s, p) {\n    lp = strlen(p)\n    if lp > strlen(s) { return false }\n    i = 0\n    while i < lp {\n        if charat(s, i) != charat(p, i) { return false }\n        i = i + 1\n    }\n    return true\n}\n\nlog(\"=== String Triage ===\")\nns = count_strings()\n\nurls = 0\npaths = 0\nfmts = 0\nkeys = 0\n\nfor i in 0..ns-1 {\n    s = string_at(i)\n    if strlen(s.value) < 4 { continue }\n\n    if startsWith(s.value, \"http://\") or startsWith(s.value, \"https://\") {\n        log(\"[url]\", s.value, \"@\", hex(s.addr))\n        bookmark(s.addr, \"url: \" + s.value)\n        urls = urls + 1\n        continue\n    }\n    if startsWith(s.value, \"/data/\") or startsWith(s.value, \"/system/\") or startsWith(s.value, \"/proc/\") {\n        log(\"[path]\", s.value)\n        paths = paths + 1\n        continue\n    }\n    if contains(s.value, \"%s\") or contains(s.value, \"%d\") or contains(s.value, \"%p\") {\n        fmts = fmts + 1\n        continue\n    }\n    if contains(s.value, \"BEGIN RSA\") or contains(s.value, \"PRIVATE KEY\") or contains(s.value, \"secret\") {\n        log(\"[!] possible key material:\", s.value, \"@\", hex(s.addr))\n        bookmark(s.addr, \"key material\")\n        keys = keys + 1\n    }\n}\n\nlog(\"--- summary ---\")\nlog(\"urls:\", urls, \"paths:\", paths, \"format strings:\", fmts, \"key-ish:\", keys)\nlog(\"=== done ===\")\n"
}
