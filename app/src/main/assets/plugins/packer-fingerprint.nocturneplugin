{
  "id": "packer-fingerprint",
  "name": "Packer Fingerprint",
  "version": "1.0",
  "author": "Nocturne",
  "description": "Reads the section table, its entropy and the runtime-loading imports, and says what is unusual about how this binary is assembled.",
  "script": "## -- helpers (NocturneScript has no arrays or substring ops) --------------\nfun contains(s, p) {\n    ls = strlen(s)\n    lp = strlen(p)\n    if lp == 0 { return true }\n    if lp > ls { return false }\n    i = 0\n    while i <= ls - lp {\n        ok = true\n        j = 0\n        while j < lp {\n            if charat(s, i + j) != charat(p, j) {\n                ok = false\n                break\n            }\n            j = j + 1\n        }\n        if ok { return true }\n        i = i + 1\n    }\n    return false\n}\n\nfun startsWith(s, p) {\n    lp = strlen(p)\n    if lp > strlen(s) { return false }\n    i = 0\n    while i < lp {\n        if charat(s, i) != charat(p, i) { return false }\n        i = i + 1\n    }\n    return true\n}\n\nfun has(s, ch) {\n    i = 0\n    while i < strlen(s) {\n        if charat(s, i) == ch { return true }\n        i = i + 1\n    }\n    return false\n}\n\n## Doubles print with %g. Two decimals makes a table that lines up.\nfun ent2(x) {\n    w = x * 100\n    w = w - (w % 1)\n    return str(w / 100)\n}\n\nfun floor1(x) { return str(x - (x % 1)) }\n\n## pad to width so the section table is a table\nfun pad(s, w) {\n    out = s\n    i = strlen(s)\n    while i < w { out = out + \" \"  i = i + 1 }\n    return out\n}\n\nlog(\"=== Packer and Obfuscation Fingerprint ===\")\nlog(\"Reads the section table, its entropy and the dynamic dependencies, and\")\nlog(\"says what is unusual about how this binary is put together.\")\nlog(\"\")\n\nW = 87    ## 'W'\nX = 88    ## 'X'\n\nscore = 0\nns = count_sections()\nni0 = count_imports()\nif ns == 0 {\n    if ni0 == 0 and count_needed() == 0 {\n        ## A DEX or a raw blob. There is no section table to be missing.\n        log(\"This format carries no section table, so none of the section,\")\n        log(\"entropy or dependency checks below apply to it. Nothing to say.\")\n        log(\"=== done ===\")\n        return\n    }\n    log(\"no section table, on a binary that has imports - it was stripped,\")\n    log(\"and a stripped ELF section table is itself a packing signature.\")\n    score = score + 2\n}\n\nlog(\"--- sections ---\")\nlog(\"  \" + pad(\"name\", 20) + pad(\"map\", 5) + pad(\"flags\", 7) + pad(\"size\", 10) + \"entropy\")\ntextSize = 0\ndataSize = 0\nwxCount = 0\nfor i in 0..ns-1 {\n    s = section_at(i)\n    if s.size == 0 { continue }\n    log(\"  \" + pad(s.name, 20) + pad(s.perm, 5) + pad(s.flags, 7) +\n        pad(str(s.size), 10) + ent2(s.entropy))\n\n    ## The section header is the linker's opinion; s.perm is the PT_LOAD the\n    ## kernel will actually map it with. Where the two disagree, believe perm.\n    writable = has(s.perm, 119)   ## 'w'\n    execable = has(s.perm, 120)   ## 'x'\n    if s.perm == \"?\" {\n        writable = has(s.flags, W)\n        execable = has(s.flags, X)\n    }\n\n    ## Size accounting uses the SECTION's own X/W bits: everything in the\n    ## r-x LOAD is mapped executable, including .dynsym, and calling that\n    ## \"code\" would make the bytes-per-function figure meaningless.\n    if has(s.flags, X) { textSize = textSize + s.size }\n    if has(s.flags, W) and not has(s.flags, X) { dataSize = dataSize + s.size }\n\n    if writable and execable {\n        log(\"      [!!] writable AND executable - this section can rewrite itself\")\n        bookmark(s.addr, \"W+X section: \" + s.name)\n        score = score + 4\n        wxCount = wxCount + 1\n    }\n    ## .rodata means read-only data. If it is writable, something intends to\n    ## write to it, and the usual something is a decrypt-in-place stub.\n    if writable and (s.name == \".rodata\" or startsWith(s.name, \".rodata\")) {\n        log(\"      [!!] .rodata is mapped WRITABLE - read-only data that is not read-only.\")\n        log(\"           A decrypt-in-place string stub needs exactly this.\")\n        bookmark(s.addr, \"writable .rodata\")\n        score = score + 3\n    }\n    ## 7.2 bits/byte is about where compressed or encrypted data starts; a\n    ## normal .rodata of English text and symbol names sits near 4.5.\n    if s.entropy > 7.2 and s.size > 4096 {\n        log(\"      [!] entropy\", ent2(s.entropy), \"- compressed, encrypted or packed payload\")\n        bookmark(s.addr, \"high entropy: \" + s.name)\n        score = score + 2\n    }\n    if execable and s.entropy > 7.0 {\n        log(\"      [!] executable section at entropy\", ent2(s.entropy),\n            \"- real code is rarely this dense\")\n        score = score + 2\n    }\n}\n\nlog(\"\")\nlog(\"--- shape ---\")\nlog(\"executable bytes:\", textSize, \"· writable data bytes:\", dataSize)\nif textSize > 0 and dataSize > textSize {\n    log(\"  [!] more writable data than code - a stub plus a packed blob looks like this\")\n    score = score + 2\n}\n\nnf = count_functions()\nni = count_imports()\nlog(\"functions:\", nf, \"· imports:\", ni)\nif nf > 0 and textSize > 0 {\n    ## bytes of code per function. A packer stub is a handful of functions\n    ## sitting on a large section; ordinary code averages a few hundred bytes.\n    per = textSize / nf\n    log(\"average\", floor1(per), \"bytes of code per discovered function\")\n    if per > 4000 {\n        log(\"  [!] very few functions for this much code - the scan is not finding\")\n        log(\"      function starts, which is what happens when code is generated\")\n        log(\"      or unpacked at runtime\")\n        score = score + 3\n    }\n}\nif nf > 40 and ni < 12 {\n    log(\"  [!] only\", ni, \"imports for\", nf, \"functions - the real imports are\")\n    log(\"      probably resolved by hand at runtime\")\n    score = score + 3\n}\n\nlog(\"\")\nlog(\"--- runtime loading ---\")\nnn = count_needed()\nlog(\"DT_NEEDED:\", nn)\nfor i in 0..nn-1 { log(\"   \", needed_at(i)) }\n\ndyn = 0\nprot = 0\nfor i in 0..ni-1 {\n    imp = import_at(i)\n    hit = false\n    why = \"\"\n    if imp.name == \"dlopen\" or imp.name == \"android_dlopen_ext\" { hit = true  why = \"loads another library at runtime\" }\n    if imp.name == \"dlsym\" { hit = true  why = \"resolves symbols by name at runtime\" }\n    if imp.name == \"mprotect\" { hit = true  why = \"changes page permissions - needed to write then execute\" }\n    if imp.name == \"memfd_create\" or imp.name == \"ashmem_create_region\" { hit = true  why = \"anonymous file - a place to unpack to\" }\n    if imp.name == \"__system_property_get\" { hit = true  why = \"reads system properties\" }\n    if hit {\n        nx = count_xrefs_to(imp.addr)\n        log(\"  [rt]\", imp.name, \"-\", nx, \"call sites -\", why)\n        if imp.name == \"dlopen\" or imp.name == \"dlsym\" or imp.name == \"android_dlopen_ext\" { dyn = dyn + nx }\n        if imp.name == \"mprotect\" { prot = prot + nx }\n        k = 0\n        shown = 0\n        while k < nx {\n            x = xref_to_at(imp.addr, k)\n            g = func_containing(x.from)\n            if g != nil {\n                comment(x.from, \"RUNTIME: \" + imp.name + \" - \" + why)\n                if shown < 4 {\n                    log(\"        from\", g.name, \"@\", hex(x.from))\n                    shown = shown + 1\n                }\n            }\n            k = k + 1\n        }\n    }\n}\nif dyn > 0 and prot > 0 {\n    log(\"  [!!] both dynamic symbol resolution and mprotect are called.\")\n    log(\"       Write-then-execute is available to this binary.\")\n    score = score + 4\n}\n\n## A known packer leaves its name in the file. Cheap to check, and when it\n## hits there is nothing left to infer.\nlog(\"\")\nlog(\"--- known packer marks ---\")\nmarks = 0\nif find_bytes(\"UPX!\") != 0 { log(\"  [!!] UPX! marker found\")  marks = marks + 1 }\nif find_bytes(\"libsecshell\") != 0 { log(\"  [!!] Bangcle/SecShell\")  marks = marks + 1 }\nif find_bytes(\"libjiagu\") != 0 { log(\"  [!!] Qihoo 360 Jiagu\")  marks = marks + 1 }\nif find_bytes(\"libDexHelper\") != 0 { log(\"  [!!] DexProtector\")  marks = marks + 1 }\nif find_bytes(\"libtprt\") != 0 { log(\"  [!!] Tencent Legu\")  marks = marks + 1 }\nif find_bytes(\"ollvm\") != 0 or find_bytes(\"OLLVM\") != 0 { log(\"  [!!] OLLVM build string\")  marks = marks + 1 }\nif find_bytes(\"Obfuscator-LLVM\") != 0 { log(\"  [!!] Obfuscator-LLVM version string\")  marks = marks + 1 }\nif marks == 0 { log(\"  none of the packer name markers this plugin knows are present\") }\nscore = score + marks * 4\n\nlog(\"\")\nlog(\"--- verdict ---\")\nlog(\"score:\", score)\nif score >= 10 {\n    log(\"PACKED or heavily obfuscated. Static reading of this binary will be\")\n    log(\"misleading; run the String Decryptor and work from the emulator.\")\n}\nif score >= 4 and score < 10 {\n    log(\"Obfuscated in places. Some of what you read statically is not what\")\n    log(\"runs.\")\n}\nif score < 4 {\n    log(\"Nothing unusual about how this binary is assembled.\")\n}\nlog(\"=== done ===\")\n"
}
