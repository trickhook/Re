{
  "id": "detection-sites",
  "name": "Detection Call Sites",
  "version": "1.0",
  "author": "Nocturne",
  "description": "Finds the root, emulator and debugger checks - the strings, the imports and the functions that hold them - and renames each checker.",
  "script": "## -- helpers (NocturneScript has no arrays or substring ops) --------------\nfun contains(s, p) {\n    ls = strlen(s)\n    lp = strlen(p)\n    if lp == 0 { return true }\n    if lp > ls { return false }\n    i = 0\n    while i <= ls - lp {\n        ok = true\n        j = 0\n        while j < lp {\n            if charat(s, i + j) != charat(p, j) { ok = false  break }\n            j = j + 1\n        }\n        if ok { return true }\n        i = i + 1\n    }\n    return false\n}\n\nfun pad(s, w) {\n    out = s\n    i = strlen(s)\n    while i < w { out = out + \" \"  i = i + 1 }\n    return out\n}\n\n## Which kind of environment check does this string belong to?\nfun kindOfString(v) {\n    if contains(v, \"/su\") or contains(v, \"magisk\") or contains(v, \"Magisk\") { return \"root\" }\n    if contains(v, \"busybox\") or contains(v, \"Superuser\") or contains(v, \"supersu\") { return \"root\" }\n    if contains(v, \"SuperSU\") or contains(v, \"test-keys\") or contains(v, \"/data/adb\") { return \"root\" }\n    if contains(v, \"qemu\") or contains(v, \"goldfish\") or contains(v, \"ranchu\") { return \"emulator\" }\n    if contains(v, \"Genymotion\") or contains(v, \"vbox\") or contains(v, \"bluestacks\") { return \"emulator\" }\n    if contains(v, \"Android SDK built\") or contains(v, \"ro.kernel\") { return \"emulator\" }\n    if contains(v, \"ro.hardware\") or contains(v, \"ro.product.model\") { return \"emulator\" }\n    if contains(v, \"TracerPid\") or contains(v, \"/proc/self/status\") { return \"debugger\" }\n    if contains(v, \"/proc/self/maps\") or contains(v, \"/proc/self/wchan\") { return \"debugger\" }\n    if contains(v, \"frida\") or contains(v, \"Frida\") or contains(v, \"gum-js\") { return \"debugger\" }\n    if contains(v, \"Xposed\") or contains(v, \"xposed\") or contains(v, \"substrate\") { return \"debugger\" }\n    if contains(v, \"ro.debuggable\") or contains(v, \"ro.secure\") { return \"debugger\" }\n    if contains(v, \"android_server\") or contains(v, \"gdbserver\") { return \"debugger\" }\n    return nil\n}\n\n## Imports that mostly appear inside a check.\nfun kindOfImport(nm) {\n    if nm == \"ptrace\" { return \"debugger\" }\n    if nm == \"getppid\" or nm == \"prctl\" { return \"debugger\" }\n    if nm == \"__system_property_get\" or nm == \"__system_property_find\" { return \"emulator\" }\n    if nm == \"uname\" { return \"emulator\" }\n    if nm == \"access\" or nm == \"faccessat\" { return \"root\" }\n    if nm == \"stat\" or nm == \"lstat\" or nm == \"fstatat\" { return \"root\" }\n    if nm == \"kill\" or nm == \"tgkill\" or nm == \"raise\" { return \"response\" }\n    if nm == \"abort\" or nm == \"_exit\" { return \"response\" }\n    return nil\n}\n\nlog(\"=== Detection Call Sites ===\")\nlog(\"Finds the root, emulator and debugger checks - the strings they compare\")\nlog(\"against, the imports they go through, and the functions that hold them.\")\nlog(\"\")\nlog(\"Only strings something references are considered. This plugin is about\")\nlog(\"call sites, and a string nothing points at is not one.\")\nlog(\"\")\n\nn = count_functions()\nns = count_strings()\nni = count_imports()\n\nrootHits = 0\nemuHits = 0\ndbgHits = 0\nrespHits = 0\nindicators = 0\n\nlog(\"--- indicators ---\")\n\nfor i in 0..ns-1 {\n    s = string_at(i)\n    if strlen(s.value) < 4 { continue }\n    nx = count_xrefs_to(s.addr, \"data\")\n    if nx == 0 { continue }\n    k = kindOfString(s.value)\n    if k == nil { continue }\n    log(\"  \" + pad(k, 10) + pad(\"\\\"\" + s.value + \"\\\"\", 40) + str(nx) + \" refs\")\n    indicators = indicators + 1\n    if k == \"root\" { rootHits = rootHits + 1 }\n    if k == \"emulator\" { emuHits = emuHits + 1 }\n    if k == \"debugger\" { dbgHits = dbgHits + 1 }\n    j = 0\n    while j < nx {\n        x = xref_to_at(s.addr, j, \"data\")\n        g = func_containing(x.from)\n        if g != nil {\n            comment(x.from, k + \" check: \\\"\" + s.value + \"\\\"\")\n            log(\"        in \" + g.name + \" @ \" + hex(x.from))\n        }\n        j = j + 1\n    }\n}\n\nfor i in 0..ni-1 {\n    imp = import_at(i)\n    ## imp.addr is the PLT stub on ELF and the IAT slot on PE -- the address\n    ## a call to this import actually reaches, whichever format this is.\n    if imp.addr == 0 { continue }\n    k = kindOfImport(imp.name)\n    if k == nil { continue }\n    nx = count_xrefs_to(imp.addr)\n    if nx == 0 { continue }\n    log(\"  \" + pad(k, 10) + pad(imp.name + \"()\", 40) + str(nx) + \" call sites\")\n    indicators = indicators + 1\n    if k == \"root\" { rootHits = rootHits + 1 }\n    if k == \"emulator\" { emuHits = emuHits + 1 }\n    if k == \"debugger\" { dbgHits = dbgHits + 1 }\n    if k == \"response\" { respHits = respHits + 1 }\n    j = 0\n    shown = 0\n    while j < nx {\n        x = xref_to_at(imp.addr, j)\n        g = func_containing(x.from)\n        if g != nil {\n            comment(x.from, k + \" check via \" + imp.name)\n            if shown < 8 {\n                log(\"        in \" + g.name + \" @ \" + hex(x.from))\n                shown = shown + 1\n            }\n        }\n        j = j + 1\n    }\n    if nx > shown { log(\"        ... and \" + str(nx - shown) + \" more\") }\n}\n\nif indicators == 0 {\n    log(\"  none.\")\n    log(\"\")\n    log(\"That is a result, not an absence. Every Android hardening blob carries\")\n    log(\"these checks; if none of their strings or imports are here, they are\")\n    log(\"being assembled at runtime. Run the Obfuscation Profile to confirm,\")\n    log(\"then the String Decryptor to recover what the code builds.\")\n    log(\"=== done ===\")\n    return\n}\n\n## Now read back, instruction by instruction, only the functions the pass\n## above found evidence in -- reached through the same xref lists, so pass 2\n## visits dozens of functions instead of scanning all of them. Walking every\n## function of a real library through this interpreter takes half a minute;\n## this takes a second, and the listing already carries the string each\n## instruction loads, so the check reads as the check.\nlog(\"\")\nlog(\"--- the checkers ---\")\ncheckers = 0\nexamined = 0\ndone = \"\"\n\nfun examine(faddr, fname, fsize) {\n    if fsize == 0 or fsize > 8192 { return false }\n    key = hex(faddr) + \";\"\n    if contains(done, key) { return false }\n    done = done + key\n    examined = examined + 1\n\n    nIns = count_insns(faddr)\n    if nIns == 0 { return false }\n\n    hits = 0\n    kinds = \"\"\n    j = 0\n    while j < nIns {\n        x = insn_at(faddr, j)\n        got = nil\n        if strlen(x.comment) > 0 {\n            got = kindOfImport(x.comment)\n            if got == nil { got = kindOfString(x.comment) }\n        }\n        if got != nil and got != \"response\" {\n            hits = hits + 1\n            if not contains(kinds, got) { kinds = kinds + got + \" \" }\n        }\n        j = j + 1\n    }\n    if hits < 2 { return false }\n\n    checkers = checkers + 1\n    log(\"\")\n    log(\"[checker]\", fname, \"@\", hex(faddr), \"-\", hits, \"indicators:\", kinds)\n    rename(faddr, \"check_\" + kinds + hex(faddr))\n    bookmark(faddr, \"environment check: \" + kinds)\n    comment(faddr, \"ENVIRONMENT CHECK - \" + str(hits) + \" indicators (\" + kinds + \")\")\n\n    seen = 0\n    j = 0\n    while j < nIns and seen < 12 {\n        x = insn_at(faddr, j)\n        got = nil\n        if strlen(x.comment) > 0 {\n            got = kindOfImport(x.comment)\n            if got == nil { got = kindOfString(x.comment) }\n        }\n        if got != nil {\n            log(\"        \" + pad(hex(x.addr), 12) + pad(x.mnem, 8) +\n                pad(x.ops, 22) + \"; \" + x.comment)\n            seen = seen + 1\n        }\n        j = j + 1\n    }\n\n    ## A check nobody calls is dead code, and worth knowing about.\n    nc = count_xrefs_to(faddr)\n    if nc == 0 {\n        log(\"        no callers found - dead, or reached indirectly\")\n    } else {\n        k = 0\n        while k < nc and k < 4 {\n            x = xref_to_at(faddr, k)\n            g = func_containing(x.from)\n            if g != nil { log(\"        called from \" + g.name + \" @ \" + hex(x.from)) }\n            k = k + 1\n        }\n    }\n    return true\n}\n\nfor i in 0..ns-1 {\n    s = string_at(i)\n    if strlen(s.value) < 4 { continue }\n    nx = count_xrefs_to(s.addr, \"data\")\n    if nx == 0 { continue }\n    if kindOfString(s.value) == nil { continue }\n    j = 0\n    while j < nx {\n        x = xref_to_at(s.addr, j, \"data\")\n        g = func_containing(x.from)\n        if g != nil { examine(g.addr, g.name, g.size) }\n        j = j + 1\n    }\n}\nfor i in 0..ni-1 {\n    imp = import_at(i)\n    ## imp.addr is the PLT stub on ELF and the IAT slot on PE -- the address\n    ## a call to this import actually reaches, whichever format this is.\n    if imp.addr == 0 { continue }\n    k = kindOfImport(imp.name)\n    if k == nil or k == \"response\" { continue }\n    nx = count_xrefs_to(imp.addr)\n    j = 0\n    while j < nx {\n        x = xref_to_at(imp.addr, j)\n        g = func_containing(x.from)\n        if g != nil { examine(g.addr, g.name, g.size) }\n        j = j + 1\n    }\n}\nif checkers == 0 {\n    log(\"  \", examined, \"functions carry indicator evidence, but none holds two\")\n    log(\"  or more - no single function looks like a dedicated check.\")\n}\n\nlog(\"\")\nlog(\"--- summary ---\")\nlog(\"indicator kinds - root:\", rootHits, \"· emulator:\", emuHits,\n    \"· debugger:\", dbgHits, \"· response:\", respHits)\nlog(\"functions read in detail:\", examined, \"· renamed as checks:\", checkers)\nif respHits > 0 and checkers > 0 {\n    log(\"[!] a kill/abort import is called alongside the checks - this binary\")\n    log(\"    does not only detect, it reacts.\")\n}\nlog(\"=== done ===\")\n"
}
