{
  "id": "xref-hotspots",
  "name": "Xref Hotspots",
  "version": "1.0",
  "author": "Nocturne",
  "description": "Ranks functions by how often they are referenced and bookmarks the most-called ones.",
  "script": "## -- helpers (NocturneScript has no arrays or substring ops) --------------\nfun contains(s, p) {\n    ls = strlen(s)\n    lp = strlen(p)\n    if lp == 0 { return true }\n    if lp > ls { return false }\n    i = 0\n    while i <= ls - lp {\n        ok = true\n        j = 0\n        while j < lp {\n            if charat(s, i + j) != charat(p, j) {\n                ok = false\n                break\n            }\n            j = j + 1\n        }\n        if ok { return true }\n        i = i + 1\n    }\n    return false\n}\n\nfun startsWith(s, p) {\n    lp = strlen(p)\n    if lp > strlen(s) { return false }\n    i = 0\n    while i < lp {\n        if charat(s, i) != charat(p, i) { return false }\n        i = i + 1\n    }\n    return true\n}\n\nlog(\"=== Xref Hotspots ===\")\nn = count_functions()\n\nbest = 0\nfor i in 0..n-1 {\n    f = func_at(i)\n    c = count_xrefs_to(f.addr)\n    if c > best { best = c }\n}\n\nif best == 0 {\n    log(\"no cross-references were recovered for this binary\")\n    return\n}\n\n## No sorting in the language, so take everything within half of the peak.\ncut = best \/ 2\nif cut < 3 { cut = 3 }\nlog(\"peak\", best, \"xrefs - reporting functions with at least\", cut)\n\nhot = 0\nfor i in 0..n-1 {\n    f = func_at(i)\n    c = count_xrefs_to(f.addr)\n    if c >= cut {\n        log(\"[hot]\", f.name, \"@\", hex(f.addr), \"-\", c, \"callers\")\n        comment(f.addr, \"HOT - \" + str(c) + \" cross-references\")\n        bookmark(f.addr, str(c) + \"x \" + f.name)\n        hot = hot + 1\n    }\n}\n\nlog(\"=== done:\", hot, \"hotspots ===\")\n"
}
