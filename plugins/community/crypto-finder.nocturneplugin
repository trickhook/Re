{
  "id": "crypto-finder",
  "name": "Crypto Finder",
  "version": "1.0",
  "author": "Nocturne",
  "description": "Finds cipher and hash routines by symbol and constant-string evidence, then bookmarks each one.",
  "script": "## -- helpers (NocturneScript has no arrays or substring ops) --------------\nfun contains(s, p) {\n    ls = strlen(s)\n    lp = strlen(p)\n    if lp == 0 { return true }\n    if lp > ls { return false }\n    i = 0\n    while i <= ls - lp {\n        ok = true\n        j = 0\n        while j < lp {\n            if charat(s, i + j) != charat(p, j) {\n                ok = false\n                break\n            }\n            j = j + 1\n        }\n        if ok { return true }\n        i = i + 1\n    }\n    return false\n}\n\nfun startsWith(s, p) {\n    lp = strlen(p)\n    if lp > strlen(s) { return false }\n    i = 0\n    while i < lp {\n        if charat(s, i) != charat(p, i) { return false }\n        i = i + 1\n    }\n    return true\n}\n\nlog(\"=== Crypto Finder ===\")\nn = count_functions()\nhits = 0\n\nfor i in 0..n-1 {\n    f = func_at(i)\n    hit = false\n    if contains(f.name, \"AES\") or contains(f.name, \"aes\") { hit = true }\n    if contains(f.name, \"SHA\") or contains(f.name, \"sha\") { hit = true }\n    if contains(f.name, \"MD5\") or contains(f.name, \"md5\") { hit = true }\n    if contains(f.name, \"RC4\") or contains(f.name, \"rc4\") { hit = true }\n    if contains(f.name, \"DES\") or contains(f.name, \"des_\") { hit = true }\n    if contains(f.name, \"RSA\") or contains(f.name, \"rsa\") { hit = true }\n    if contains(f.name, \"HMAC\") or contains(f.name, \"hmac\") { hit = true }\n    if contains(f.name, \"crypt\") or contains(f.name, \"Crypt\") { hit = true }\n    if contains(f.name, \"cipher\") or contains(f.name, \"Cipher\") { hit = true }\n    if contains(f.name, \"EVP_\") { hit = true }\n    if hit {\n        log(\"[crypto]\", f.name, \"@\", hex(f.addr), \"-\", f.size, \"bytes\")\n        comment(f.addr, \"CRYPTO - cipher\/hash routine\")\n        bookmark(f.addr, \"crypto: \" + f.name)\n        hits = hits + 1\n    }\n}\n\nns = count_strings()\nsev = 0\nfor i in 0..ns-1 {\n    s = string_at(i)\n    if contains(s.value, \"AES\") or contains(s.value, \"aes-\") {\n        log(\"[str]\", s.value)\n        sev = sev + 1\n    }\n    if contains(s.value, \"sha256\") or contains(s.value, \"SHA256\") {\n        log(\"[str]\", s.value)\n        sev = sev + 1\n    }\n}\n\nlog(\"=== done:\", hits, \"crypto functions,\", sev, \"crypto strings ===\")\n"
}
